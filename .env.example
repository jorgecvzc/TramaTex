# TramaTex Root Environment Configuration
# Copy this file to .env or .env.local and fill with real values
# DO NOT commit .env files with credentials

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_password_here
DB_NAME=tramatex

# API Configuration
API_HOST=localhost
API_PORT=8080

# JWT Configuration
JWT_SECRET=generate_a_secure_random_string_minimum_32_characters

# Application Environment
ENV=development
LOG_LEVEL=info
