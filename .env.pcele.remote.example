# TramaTex Remote Environment Configuration (Example: pcele machine)
# Copy this file to .env.[machine-name].remote for your specific remote server
# Example: .env.production-server.remote, .env.staging.remote
# DO NOT commit .env.*.remote files with real credentials

# Remote Server Configuration
REMOTE_HOST=pcele.example.com
REMOTE_PORT=22
REMOTE_USER=tramatex_deploy

# Database Configuration (Remote)
DB_HOST=postgres_remote
DB_PORT=5432
DB_USER=your_remote_db_user  
DB_PASSWORD=your_secure_remote_password
DB_NAME=tramatex_production
DB_SSLMODE=require

# API Configuration (Remote)
API_HOST=0.0.0.0
API_PORT=8080
API_URL=https://api.pcele.example.com

# JWT Configuration (Production-strength)
# Generate with: openssl rand -base64 64
JWT_SECRET=generate_a_very_secure_random_string_minimum_64_characters_for_production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# CORS Configuration (Production)
CORS_ALLOWED_ORIGINS=https://app.pcele.example.com,https://www.pcele.example.com

# Logging (Production)
LOG_LEVEL=warn
ENV=production

# SSL/TLS (if applicable)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
