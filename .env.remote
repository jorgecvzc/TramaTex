# TramaTex Docker Configuration - Remote (pcele Linux Server)
# Environment: REMOTE (Docker on pcele via SSH)

## SSH Configuration
SSH_USER=ele
SSH_HOST=pcele
SSH_PORT=22
SSH_PASSWORD=2441

## Docker Daemon Configuration (on remote)
DOCKER_DRIVER=bridge
DOCKER_HOST=unix:///var/run/docker.sock

## PostgreSQL Configuration
DB_IMAGE=postgres:15-alpine
DB_CONTAINER=tramatex_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=tramatex
DB_PASSWORD=tramatex
DB_NAME=tramatex
DB_SSLMODE=disable

## API Configuration
API_CONTAINER=tramatex_api
API_HOST=0.0.0.0
API_PORT=8080
API_EXTERNAL_HOST=pcele

## Frontend Configuration (if applicable)
FRONTEND_PORT=5173

## JWT Configuration
JWT_SECRET=change-me-in-production-super-secret-key-2024-remote
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

## Environment
ENV=production
LOG_LEVEL=info

## CORS
CORS_ALLOWED_ORIGINS=http://192.168.0.20:5173,http://192.168.0.20,http://localhost:5173

## Network Configuration
NETWORK_NAME=tramatex_network
VOLUME_PREFIX=remote

## Connection Test Command (Linux/SSH)
CONNECTION_TEST_CMD=ssh ele@pcele "curl -f http://localhost:8080/api/health"
