# TramaTex Docker Environment — PCELE (LAN Pre-Staging)
# Copy to docker/.env on pcele server: /opt/tramatex/docker/.env
# Server: 192.168.0.20, User: ele

# ============================================================================
# PostgreSQL
# ============================================================================
DB_IMAGE=postgres:15-alpine
DB_CONTAINER=tramatex_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=tramatex
DB_PASSWORD=CHANGE_ME_pcele_password
DB_NAME=tramatex
DB_SSLMODE=disable

# ============================================================================
# API
# ============================================================================
API_CONTAINER=tramatex_api
API_HOST=0.0.0.0
API_PORT=8080
ENV=production
LOG_LEVEL=info

# ============================================================================
# JWT — Generate: openssl rand -base64 48
# ============================================================================
JWT_SECRET=CHANGE_ME_pcele_jwt_secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ============================================================================
# Frontend (Nginx) — Accesible en http://192.168.0.20
# ============================================================================
FRONTEND_CONTAINER=tramatex_frontend
FRONTEND_PORT=80

# ============================================================================
# CORS — Acepta peticiones desde la IP de pcele y localhost
# ============================================================================
CORS_ALLOWED_ORIGINS=http://192.168.0.20,http://localhost
