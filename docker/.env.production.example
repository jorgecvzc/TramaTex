# TramaTex Docker Environment — PRODUCTION (DigitalOcean)
# This file is written by GitHub Actions from secrets.
# To configure, set these as the ENV_STAGING / ENV_PROD secret in GitHub.
# Each line becomes a line in docker/.env on the server.
#
# For staging: use GitHub Secret ENV_STAGING with these values
# For production: use GitHub Secret ENV_PROD with these values

# ============================================================================
# PostgreSQL
# ============================================================================
DB_IMAGE=postgres:15-alpine
DB_CONTAINER=tramatex_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=tramatex
DB_PASSWORD=CHANGE_ME_strong_production_password
DB_NAME=tramatex
DB_SSLMODE=disable

# ============================================================================
# API
# ============================================================================
API_CONTAINER=tramatex_api
API_HOST=0.0.0.0
API_PORT=8080
ENV=production
LOG_LEVEL=warn

# ============================================================================
# JWT — Generate: openssl rand -base64 48
# ============================================================================
JWT_SECRET=CHANGE_ME_production_jwt_secret_minimum_64_characters
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ============================================================================
# Frontend (Nginx) — Port 80 (SSL terminates at host or load balancer)
# ============================================================================
FRONTEND_CONTAINER=tramatex_frontend
FRONTEND_PORT=80

# ============================================================================
# CORS — Use your actual domain
# ============================================================================
CORS_ALLOWED_ORIGINS=https://tramatex.example.com
