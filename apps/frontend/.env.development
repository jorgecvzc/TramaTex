# Frontend Environment - Development
# Use Vite proxy to avoid CORS issues in development
# The proxy is configured in vite.config.js to forward /api to localhost:8080

# VITE_API_URL should NOT be set in development to use the proxy
# VITE_API_URL=/api

# Print issuer profile (optional in development)
# VITE_PRINT_ISSUER_NAME=TramaTex Demo
# VITE_PRINT_ISSUER_TAX_LABEL=CIF
# VITE_PRINT_ISSUER_TAX_ID=B12345678
# VITE_PRINT_ISSUER_ADDRESS=C/ Demo 1
# VITE_PRINT_ISSUER_CITY=28001 Madrid
# VITE_PRINT_ISSUER_CONTACT=demo@tramatex.local
