# Frontend Environment Configuration
# Copy this file to .env.development (for dev) or .env.production (for prod)
# Fill with appropriate values - DO NOT commit .env files with real secrets

# API URL Configuration
# In development: Leave commented to use Vite proxy (see vite.config.js)
# In production: Set to your API server URL
# VITE_API_URL=http://localhost:8080/api

# Print Issuer Profile (Optional)
# Used for invoice/document generation
VITE_PRINT_ISSUER_NAME=Your Company Name
VITE_PRINT_ISSUER_TAX_LABEL=CIF
VITE_PRINT_ISSUER_TAX_ID=B00000000
VITE_PRINT_ISSUER_ADDRESS=Your Address
VITE_PRINT_ISSUER_CITY=00000 Your City
VITE_PRINT_ISSUER_CONTACT=contact@yourcompany.com

# Application Configuration
# VITE_APP_TITLE=TramaTex ERP
# VITE_APP_VERSION=1.0.0
