# Application
ENV=development
PORT=8080

# CORS Configuration
# Comma-separated list of allowed origins, or "*" for all (NOT recommended for production)
# Example: http://localhost:3000,https://app.tramatex.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=tramatex_user
DB_PASSWORD=tramatex_pass
DB_NAME=tramatex_db

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Logging
LOG_LEVEL=info
